# FastAPI server configurations
HOST=0.0.0.0
PORT=8000

# Database configurations (Postgres port 5434, passwordless)
DATABASE_URL=postgresql://postgres@localhost:5434/voice_assistant

# Vapi Integration Credentials
VAPI_API_KEY=vapi_api_key_placeholder
VAPI_SECRET_TOKEN=vapi_secret_token_placeholder
VAPI_PHONE_NUMBER_ID=vapi_phone_number_id_placeholder

# Twilio Credentials
TWILIO_ACCOUNT_SID=AC_twilio_account_sid_placeholder
TWILIO_AUTH_TOKEN=twilio_auth_token_placeholder
TWILIO_PHONE_NUMBER=+1234567890