# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5434/voice_assistant

# Vapi Configuration
VAPI_API_KEY=vapi_api_key_placeholder
VAPI_SECRET_TOKEN=vapi_secret_token_placeholder
VAPI_PHONE_NUMBER_ID=vapi_phone_number_id_placeholder

# Twilio Configuration
TWILIO_ACCOUNT_SID=twilio_account_sid_placeholder
TWILIO_AUTH_TOKEN=twilio_auth_token_placeholder
TWILIO_PHONE_NUMBER=+1 (Unknown Twilio Number)

# Server Configuration
HOST=0.0.0.0
PORT=8000
NODE_ENV=development
