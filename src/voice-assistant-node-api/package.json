{
    "name": "voice-assistant-node-api",
    "version": "1.0.0",
    "description": "Voice Assistant Receptionist API - Node.js Express Implementation",
    "main": "dist/index.js",
    "type": "module",
    "author": "",
    "license": "",
    "scripts": {
        "dev": "node --watch --loader tsx src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "lint": "eslint src --ext .ts",
        "format": "prettier --write \"src/**/*.ts\"",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "voice-assistant",
        "receptionist",
        "api",
        "express",
        "typescript"
    ],
    "dependencies": {
        "express": "^4.18.2",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "typeorm": "^0.3.19",
        "pg": "^8.11.3",
        "uuid": "^9.0.1",
        "axios": "^1.6.8",
        "joi": "^17.12.2"
    },
    "devDependencies": {
        "typescript": "^5.3.3",
        "@types/express": "^4.17.21",
        "@types/node": "^20.10.6",
        "@types/uuid": "^9.0.7",
        "@types/cors": "^2.8.17",
        "tsx": "^4.7.0",
        "eslint": "^8.56.0",
        "@typescript-eslint/eslint-plugin": "^6.17.0",
        "@typescript-eslint/parser": "^6.17.0",
        "prettier": "^3.1.1"
    }
}